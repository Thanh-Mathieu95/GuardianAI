# Copy to .env.local. Never commit real keys.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-mini
AI_ENABLED=true
# Required for published deployments. Share this code only with invited demo participants.
AI_ACCESS_CODE=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
DATABASE_PATH=./data/guardian.sqlite
# Optional PostgreSQL connection. TLS certificate validation stays enabled.
DATABASE_URL=
GOOGLE_MAPS_API_KEY=
# Local demo: leave empty. Published app: exact public HTTPS origin.
PUBLIC_URL=
# Single continuous Node server required. Use 0.0.0.0 only on the hosted backend.
GUARDIAN_BIND_HOST=127.0.0.1
PORT=3131
# Optional separate frontend; configure at build time and set backend PUBLIC_URL to the frontend URL.
GUARDIAN_BACKEND_ORIGIN=
