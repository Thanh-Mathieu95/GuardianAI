# All integrations default to offline simulation. Never commit real secrets.
GUARDIAN_DB_PATH=./data/guardian.sqlite
GUARDIAN_RECORDINGS_DIR=./data/recordings
# Hosting only: the HTTPS origin of this deployment, without a path.
PUBLIC_URL=
# Hosting only: a stable, randomly generated server secret. Never commit its value.
GUARDIAN_SESSION_SECRET=
# Set to 1 for a free hosted demo with temporary storage; also set during build.
GUARDIAN_DEMO_HOSTING=0
# Optional Google APIs; set adapter to GOOGLE in control panel after configuration.
GOOGLE_MAPS_API_KEY=
# Optional team-controlled call gateway (see docs/INTEGRATIONS.md).
CALL_GATEWAY_URL=
CALL_GATEWAY_TOKEN=
TEST_CALL_ALLOWLIST=
# Optional explicit operator password. With no password, localhost demo sessions get a capability.
OPERATOR_PASSWORD=

# Real AI (independent of map/call SIMULATION mode).
# OpenAI GPT only. OFF disables models.
AI_PROVIDER=OPENAI
AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
AI_TIMEOUT_MS=25000
# Voice companion (WebRTC). gpt-realtime-mini is ~3x cheaper.
AI_REALTIME_MODEL=gpt-realtime
# Anti-spam: SOS per user per hour that may ring partners (raise while rehearsing).
SOS_PER_HOUR=3
